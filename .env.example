# SnapDown-Anything 配置模板
#
# 用法：复制为同目录下的 .env 再按需修改（.env 已在 .gitignore 中忽略）。
# 注意：只在进程启动时读取一次，改完需重启；已存在的环境变量优先级高于本文件。

# ---- 服务 ----
HOST=127.0.0.1
PORT=8787
# 数据目录：数据库、下载分片与成品（默认 .data）
# DATA_DIR=.data
# 前端构建产物目录（默认 web/dist）
# WEB_DIST=web/dist

# ---- 代理 ----
# auto：本机客户端代理优先，服务器端代理兜底；local / server 锁定单一路径；off 关闭代理
PROXY_MODE=auto
# 本机客户端代理，留空 = 自动探测系统代理
# PROXY_LOCAL=http://127.0.0.1:10808
# 服务器端代理兜底（部署到海外机器时填）
# PROXY_SERVER=
# 代理健康检查地址与超时（秒）
# PROXY_PROBE_URL=https://www.youtube.com/generate_204
# PROXY_PROBE_TIMEOUT=6

# ---- 限频与队列 ----
# 平台冷却秒数，格式 平台:秒，逗号分隔；无法解析的项会被忽略
# COOLDOWN_SECONDS=bilibili:3,douyin:5,youtube:3
# 同时执行的任务上限
# MAX_ACTIVE_TASKS=3
# 单次输入（链接或分享文案）字符上限
# MAX_INPUT_CHARS=2000

# ---- 存储 ----
# 完成文件保留时长（小时），到期自动清理
# FILE_TTL_HOURS=24
# 中断/失败任务的工作目录保留天数（保留才能续传）
# WORK_TTL_DAYS=7

# ---- 其它 ----
# 日志级别：DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO
# 传给 yt-dlp 的 User-Agent（留空用内置 Chrome UA）
# USER_AGENT=
# FFmpeg / FFprobe 绝对路径（留空则走 PATH）
# FFMPEG_PATH=
# FFPROBE_PATH=
# 开发态允许的跨域来源（逗号分隔）
# DEV_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
